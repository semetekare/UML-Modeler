usecase e11 as "Выбрать читаемые курсы" <<sea level usecase>>
usecase e8 as "Зарегистрироваться на курсы" <<sea level usecase>>
usecase e10 as "Просмотреть табель" <<sea level usecase>>
usecase e17 as "Закрыть регистрацию" <<fish level usecase>>
usecase e13 as "CRUD данных о профессорах" <<sea level usecase>>
usecase e16 as "Открыть регистрацию" <<sea level usecase>>
usecase e14 as "CRUD данных о студентах" <<sea level usecase>>
usecase e12 as "Поставить оценки" <<sea level usecase>>
usecase e15 as "CRUD данных о курсах и дисциплинах" <<sea level usecase>>
}
e3 --|> e2
e4 --|> e2
e5 --|> e2
e2 --> e9
e3 --> e8
e3 --> e10
e4 --> e11
e4 --> e12
e5 --> e16
