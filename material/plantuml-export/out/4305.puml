@startuml
title DisplayCourseOfferings Subflow
participant e2 as "rform:RegistrationForm" <<boundary>>
participant e3 as "rctrl:RegistrationController" <<control>>
collections e4 as "cOff[i]:CourseOffering" <<entity>>
loop for all cOff[i]
e2 -> e3 : getCourseOfferingList(semester : byte) : CourseOffering[]
e3 --> e2 : cOff[]
e2 -> e4 : toJSON() : string
e2 -> e2 : displayCourseString()
end
@enduml
