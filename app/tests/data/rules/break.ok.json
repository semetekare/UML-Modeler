    {
      "id": "e6",
      "kind": "fragment",
      "name": "Верхний break",
      "documentation": "Граница: у break нет объемлющего фрагмента (ownerId не задан) — сравнивать не с чем, правило молчит. Сообщение у него своё (r4): одно сообщение в двух фрагментах без общей вложенности — уже другой дефект, Message::cannot_cross_boundaries.",
      "operands": [
        {
          "id": "o1",
          "guard": "[отмена]",
          "messages": [
            "r4"
          ]
        }
      ],
      "operator": "break"
    },
    {
      "id": "e7",
      "kind": "fragment",
      "name": "Внешний без сообщений",
      "operands": [
        {
          "id": "o1"
        }
      ],
      "operator": "opt"
    },
    {
      "id": "e8",
      "kind": "fragment",
      "name": "Вложенный break без покрытия",
      "documentation": "Граница: у объемлющего фрагмента ещё нет сообщений, покрытие не выведено — правило молчит. Сообщение у него тоже своё (r5), чтобы не делить его с соседними фрагментами.",
      "ownerId": "e7",
      "operands": [
        {
          "id": "o1",
          "guard": "[ошибка]",
          "messages": [
            "r5"
          ]
        }
      ],
      "operator": "break"
    }
