# --- Сайт вокруг продукта: не функциональность UML Modeler ------------------
# Лендинг, приёмник статистики, дашборд и план продвижения живут на машине
# владельца (и в отдельном приватном репозитории). В публичном репозитории
# продукта им места нет: там только приложение, иконка GitHub и флаг сборки
# --telemetry, который читает адрес приёма из окружения и никогда из файла.
landing/
analytics/
docs/seo/
# Адрес приёмника и токены — только в окружении сборки, никогда в файле.
.build.env
.build.env.*

# --- Текст стандарта OMG: права OMG, в репозиторий не входит --------------
# Локально полный текст остаётся (reference/spec — исходники, app/reference/spec —
# собранный справочник); в поставку build.mjs кладёт вариант без прозы.
reference/spec/
material/reference-content/spec-sections/
app/reference/spec/

# --- Одноразовые исследовательские пробники (абсолютные пути, не для сборки) ---
material/pictograms/rejected-trace/

# Снимки скомпилированного бандла draw.io (по 10,3 МБ, один — дубликат другого).
