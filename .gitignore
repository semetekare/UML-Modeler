# --- Сборка ---------------------------------------------------------------
# `node build.mjs` копирует сайт в app/dist/; это артефакт, а не исходник.
app/dist/

# --- Снимки проекта и VPS (≈320 МБ) --------------------------------------
backups/

# --- Логи прогонов --------------------------------------------------------
*.log

# --- Служебный мусор ------------------------------------------------------
.obsidian/
__pycache__/
*.pyc
.DS_Store
*~
*.swp

# --- Временная диагностика параллельной сессии (чистка текста интерфейса) --
#     Файл помечен в шапке как temporary; в истории ему места нет.
app/tools/_vp-dump.mjs

# --- Инфраструктура и внутреннее состояние (остаётся на машине владельца) ---
deploy/
